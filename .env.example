# =============================================================================
# Environment template for the process-mining framework.
#
# Copy this file to `.env` and fill in real values. `.env` itself is
# gitignored. The `export` prefix is optional (the dotenv loader strips it);
# kept for parity with shell-sourced workflows.
# =============================================================================


# -----------------------------------------------------------------------------
# Database (REQUIRED)
# -----------------------------------------------------------------------------
# PostgreSQL connection string. Tested against Neon (managed Postgres) but
# any Postgres 13+ works. Used by SQLAlchemy + Alembic.
#   Format: postgresql://<user>:<pass>@<host>:<port>/<db>?<opts>
# Required `sslmode=require` for Neon; `channel_binding=require` is
# recommended.
DATABASE_URL="postgresql://<user>:<password>@<host>/<database>?sslmode=require&channel_binding=require"


# -----------------------------------------------------------------------------
# Azure OpenAI (REQUIRED for the LLM RCA investigator)
# -----------------------------------------------------------------------------
# Used by app/investigators/llm_rca_investigator.py.
#   - INSTANCE: from your Azure OpenAI resource overview
#   - DEPLOYMENT: the *deployment name* you created for a chat model
#                 (e.g. gpt-4.1-mini, gpt-4o, etc.)
#   - API_VERSION: 2024-12-01-preview is known-good
#
# Without these, the investigator falls back to evidence-only reports
# (no LLM synthesis — pipeline still produces findings + ServiceNow tickets,
# just without the cross-source narrative).
export AZURE_OPENAI_API_KEY="<your-azure-openai-key>"
export AZURE_OPENAI_ENDPOINT="https://<your-instance>.openai.azure.com/openai/v1"
export AZURE_OPENAI_DEPLOYMENT="<your-deployment-name>"
export AZURE_OPENAI_API_VERSION="2024-12-01-preview"

# POINT 19 (Task #19): embedding model for hybrid precedent retrieval (semantic
# arm). Deploy text-embedding-3-small in your Azure OpenAI resource and put the
# DEPLOYMENT NAME here. Reuses AZURE_OPENAI_API_KEY / ENDPOINT above. If unset,
# the embedder falls back to a hashed (non-semantic) vector.
export AZURE_OPENAI_EMBED_DEPLOYMENT="text-embedding-3-small"

# POINT 20 (Task #20): Jira (read by the local MCP server, app/mcp_servers/jira_server.py).
# Set all three to file REAL tickets; leave unset and the MCP server writes mock ticket
# files to data/output/jira_mock/ instead (so the flow works without credentials).
# Get a free site + token: https://id.atlassian.com/manage-profile/security/api-tokens
export JIRA_URL="https://your-site.atlassian.net"
export JIRA_EMAIL="you@example.com"
export JIRA_API_TOKEN="<your-atlassian-api-token>"

# Secrets source: leave UNSET locally (uses this .env). In Azure, set it to your Key
# Vault URL and the app reads secrets from there via Managed Identity (names: env var
# FOO_BAR -> KV secret FOO-BAR). Local dev never needs Azure auth.
# export AZURE_KEY_VAULT_URL="https://<your-vault>.vault.azure.net/"


# -----------------------------------------------------------------------------
# POINT 21 (Task #21): observability — OpenTelemetry + Langfuse (OPTIONAL)
# -----------------------------------------------------------------------------
# Only used when observability.otel_enabled / langfuse_enabled are true in
# modules.yaml AND the optional packages are installed:
#     pip install opentelemetry-sdk opentelemetry-exporter-otlp
#
# Langfuse (LLM/model events) — get keys from your Langfuse project settings.
# Cloud: https://cloud.langfuse.com (or https://us.cloud.langfuse.com). Self-host:
# your own URL. The app sends OTLP traces to {HOST}/api/public/otel — no Langfuse SDK.
# export LANGFUSE_HOST="https://cloud.langfuse.com"
# export LANGFUSE_PUBLIC_KEY="pk-lf-..."
# export LANGFUSE_SECRET_KEY="sk-lf-..."
#
# Infra/APM traces (optional, separate from Langfuse) — point at any OTLP collector
# (Azure Monitor exporter, Grafana Tempo, Jaeger, etc.):
# export OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:4318"


# -----------------------------------------------------------------------------
# ServiceNow ticket creation + historical read (OPTIONAL)
# -----------------------------------------------------------------------------
# POINT 19 (Task #19): these SAME three vars are also used to READ resolved
# incidents as RCA precedent (app/servicenow_history/ +
# scripts/sync_servicenow_history.py). That path needs READ access to the
# incident table (including close/resolution notes).
#
# When all three are set, ServiceNowReportSink runs in 'real' mode and
# creates incident tickets via the REST API. When any are missing, the
# sink falls back to 'mock' mode (writes JSON files under
# data/output/servicenow_mock/).
#
# For a free developer instance: sign up at developer.servicenow.com,
# request a Personal Developer Instance (PDI), and copy the admin
# credentials shown after provisioning.
SERVICENOW_INSTANCE_URL="https://dev<XXXXXX>.service-now.com"
SERVICENOW_USERNAME="admin"
SERVICENOW_PASSWORD="<your-instance-password>"